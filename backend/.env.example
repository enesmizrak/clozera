# Server
NODE_ENV=development
PORT=3000

# Database
# Use localhost for running MongoDB directly on your machine.
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/clozera

# If you run the backend with Docker Compose and the Mongo service is named
# "mongodb", use this instead:
# MONGODB_CONNECTION_STRING=mongodb://mongodb:27017/clozera

# MongoDB Atlas example:
# Replace every placeholder and URL-encode special characters in the password.
# MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster-host>/clozera?retryWrites=true&w=majority&appName=clozera

# Enable on Atlas (replica set) so sign-up writes user and account atomically.
# Leave disabled for the standalone local MongoDB container.
# MONGODB_TRANSACTIONS=true

# Web app origin. Browsers reach the API through the web app's same-origin /api proxy.
FRONTEND_URL=http://localhost:5173

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public URL of /api/auth. Defaults to FRONTEND_URL because the web app proxies /api.
# BETTER_AUTH_URL=http://localhost:5173

RESEND_API_KEY=re_.....
EMAIL_FROM="Domain-Name <no-reply@domain-name.app>"
EMAIL_REPLY_TO="info@domain-name.app"

# Email
# Development: leave EMAIL_TRANSPORT unset to print emails to the console, or use Mailpit
# (docker compose up -d mailpit; inbox at http://localhost:8025):
# EMAIL_TRANSPORT=smtp
# SMTP_URL=smtp://localhost:1025
# Production uses Resend and requires RESEND_API_KEY. Tests never send email.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=re_...
EMAIL_FROM="Clozera <no-reply@clozera.app>"
EMAIL_REPLY_TO=info@clozera.app

# Admin bootstrap
# Used by: npm run admin:upsert and npm run seed:initials
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=super-secret-password
# ADMIN_USERNAME=admin
# ADMIN_NAME=Admin
# ADMIN_TIMEZONE=UTC
