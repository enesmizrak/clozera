# Server-side only (SSR and the /api proxy). Defaults to http://localhost:3000.
# Export it in the shell or set it in the container environment; it is never sent to the browser.
API_INTERNAL_URL=http://localhost:3000

# Where the visitor IP comes from (used for auth rate limits). Behind Cloudflare: cf-connecting-ip
# CLIENT_IP_HEADER=
# Proxies in front of this server that append to X-Forwarded-For (Coolify without Cloudflare: 1). Ignored when CLIENT_IP_HEADER is set.
# TRUSTED_PROXY_HOPS=0
